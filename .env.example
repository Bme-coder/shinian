# Copy to .env locally; use hosting settings for deployment. Never commit secrets.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# chat or responses
AI_PROTOCOL=chat
# false for compatible providers without response_format support.
AI_JSON_MODE=true
# Generate a random token of at least 16 characters: openssl rand -hex 24
APP_ACCESS_TOKEN=
# Separate frontend origin, e.g. https://yourname.github.io
ALLOWED_ORIGINS=
PORT=8787
